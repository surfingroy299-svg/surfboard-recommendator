# OS
.DS_Store

# Dependencies and build output (any nested app)
node_modules/
dist/
*.tsbuildinfo

# Local tooling
.vscode/
.claude/settings.local.json
.claude/worktrees/
.claude/skills/

# design-exploration/ is tracked as project history (see its README). Only its
# build output is excluded, which the node_modules/ and dist/ rules above already do.

# Reference photography: documented placeholders, not cleared for publication.
# The register and manifest ARE tracked; see photography/REGISTER.md.
frontend/comparison-prototype/public/photography/*
!frontend/comparison-prototype/public/photography/MANIFEST.json
